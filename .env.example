# Public browser configuration. These two values are the only variables copied
# into Vercel and extension builds.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider and signing secrets. Store these in Supabase Edge
# Function secrets; never expose them to Vite or extension builds.
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# Canonical web origin and stable unpacked extension ID. These are non-secret
# Edge Function configuration values and APP_URL also configures Supabase Auth.
APP_URL=
ALLOWED_EXTENSION_IDS=
