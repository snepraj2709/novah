{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024"
  },
  "include": [
    "deno-globals.d.ts",
    "_shared/**/*.ts",
    "capture-note/**/*.ts",
    "search-notes/**/*.ts",
    "telegram-link-code/**/*.ts",
    "telegram-webhook/**/*.ts"
  ],
  "exclude": ["tests"]
}
