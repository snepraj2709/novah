{
  "name": "novah",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "set -a; . ./.env; set +a; pnpm --filter web dev --host 127.0.0.1 --port 5173 --strictPort",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db && node scripts/verify-practice-concurrency.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/types/database.generated.ts && prettier --write packages/shared/src/types/database.generated.ts",
    "test:practice:upgrade": "node scripts/verify-practice-upgrade.mjs",
    "test:functions": "node --experimental-strip-types --test supabase/functions/tests/*.test.ts",
    "test:telegram:hosted": "node scripts/verify-phase-4-hosted.mjs",
    "test:security": "node scripts/verify-phase-7-security.mjs",
    "test:phase8:config": "node scripts/verify-phase-8-config.mjs",
    "test:phase8:production-status": "node scripts/verify-phase-8-production-status.mjs",
    "test:phase9:package": "node scripts/verify-phase-9-package.mjs",
    "test:retrieval:validate": "node scripts/evaluate-retrieval.mjs --validate",
    "test:retrieval:live": "node scripts/evaluate-retrieval.mjs --live",
    "phase5:cron:configure": "node scripts/manage-phase-5-cron.mjs configure",
    "phase5:cron:status": "node scripts/manage-phase-5-cron.mjs status",
    "phase5:cron:remove": "node scripts/manage-phase-5-cron.mjs remove",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint apps packages supabase/functions --deny-warnings",
    "typecheck": "pnpm --recursive --if-present typecheck && pnpm typecheck:functions",
    "typecheck:functions": "tsc --project supabase/functions/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.111.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0",
    "typescript": "~6.0.3",
    "zod": "4.4.3"
  }
}
