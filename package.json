{
  "name": "novah",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db && node scripts/verify-practice-concurrency.mjs",
    "db:test:hosted": "node scripts/verify-phase-1-hosted.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/types/database.generated.ts && prettier --write packages/shared/src/types/database.generated.ts",
    "test:functions": "node --experimental-strip-types --test supabase/functions/tests/*.test.ts",
    "test:functions:hosted": "node scripts/verify-phase-2-hosted.mjs",
    "test:telegram:hosted": "node scripts/verify-phase-4-hosted.mjs",
    "test:telegram:live": "node scripts/verify-phase-4-live.mjs",
    "test:notifications:hosted": "node scripts/verify-phase-5-hosted.mjs",
    "test:notifications:live": "node scripts/verify-phase-5-live.mjs",
    "test:notifications:live:preflight": "node scripts/verify-phase-5-live.mjs --preflight",
    "test:notifications:live:cleanup": "node scripts/verify-phase-5-live.mjs --audit-cleanup",
    "test:dashboard:local": "node scripts/verify-phase-6-local.mjs",
    "test:dashboard:local:owned-delete": "node scripts/verify-phase-6-local.mjs --assert-owned-delete",
    "test:dashboard:local:account-delete": "node scripts/verify-phase-6-local.mjs --assert-account-delete",
    "test:dashboard:local:account-delete-e2e": "node scripts/verify-phase-6-local.mjs --exercise-account-delete",
    "test:dashboard:local:cleanup": "node scripts/verify-phase-6-local.mjs --cleanup",
    "test:phase7:hosted-audit": "node scripts/verify-phase-7-hosted-audit.mjs",
    "test:security": "node scripts/verify-phase-7-security.mjs",
    "test:phase8:config": "node scripts/verify-phase-8-config.mjs",
    "test:phase8:production-status": "node scripts/verify-phase-8-production-status.mjs",
    "test:phase9:package": "node scripts/verify-phase-9-package.mjs",
    "phase8:smoke:create": "node scripts/manage-phase-8-smoke.mjs create",
    "phase8:smoke:status": "node scripts/manage-phase-8-smoke.mjs status",
    "phase8:smoke:telegram:prepare": "node scripts/manage-phase-8-smoke.mjs telegram-prepare",
    "phase8:smoke:telegram:restore": "node scripts/manage-phase-8-smoke.mjs telegram-restore",
    "phase8:smoke:review:prepare": "node scripts/manage-phase-8-smoke.mjs review-prepare",
    "phase8:smoke:cleanup": "node scripts/manage-phase-8-smoke.mjs cleanup",
    "test:retrieval:validate": "node scripts/evaluate-retrieval.mjs --validate",
    "test:retrieval:live": "node scripts/evaluate-retrieval.mjs --live",
    "phase5:cron:configure": "node scripts/manage-phase-5-cron.mjs configure",
    "phase5:cron:status": "node scripts/manage-phase-5-cron.mjs status",
    "phase5:cron:remove": "node scripts/manage-phase-5-cron.mjs remove",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint apps packages supabase/functions --deny-warnings",
    "typecheck": "pnpm --recursive --if-present typecheck && pnpm typecheck:functions",
    "typecheck:functions": "tsc --project supabase/functions/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.111.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0",
    "typescript": "~6.0.3",
    "zod": "4.4.3"
  }
}
