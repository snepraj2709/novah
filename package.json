{
  "name": "novah",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:test:hosted": "node scripts/verify-phase-1-hosted.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/types/database.generated.ts && prettier --write packages/shared/src/types/database.generated.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint apps packages --deny-warnings",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0"
  }
}
